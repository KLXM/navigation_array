        "navigation",
        "menu",
        "breadcrumb"
    ],
    "authors": [
        {
            "name": "Thomas Skerbis",
            "homepage": "https://github.com/skerbis",
            "role": "Lead"
        },
        {
            "name": "KLXM Crossmedia GmbH",
            "homepage": "https://klxm.de"
        },
        {
            "name": "Friends Of REDAXO",
